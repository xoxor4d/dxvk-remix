#pragma once

// rtx_fork_lod_fade.slangh - fork-owned. LOD cross fade (rtx.lodFade.*): a surface whose fade opacity is below 255 is
// skipped wherever the pixel's blue noise sample is at or above it. The fading instance is non-opaque, so ray queries
// see it as a candidate and leave a skipped surface uncommitted (forkLodFadeCandidateSkipped, visibility rays alike);
// the TraceRay path re-traces past it like past a clip plane, a skipped hit handed to a surface on the same plane
// (forkLodFadeFindCoplanarHit). See docs/RemixLodFadeAPI_gta4.md.
// Included by resolve.slangh after the ray and surface concepts.

#include "rtx/utility/noise.slangh"

uint forkLodFadeOpacity(Surface surface)
{
  return cb.lodFadeDebugForceOpacity != 255u ? cb.lodFadeDebugForceOpacity : surface.lodFadeOpacity;
}

// One sample per pixel and frame, the same for every ray of the path (primary, bounces and visibility rays all run in
// the pixel's thread), so a path sees one side of a cross fade and temporal accumulation blends the two.
uint forkLodFadeThreshold()
{
  RNG rng = createRNGAnywhere(cb.frameIdx, 777);
  return uint(getNextSampleBlueNoise(rng) * 256.0f);
}

bool forkIsSurfaceFadedOut(Surface surface)
{
  const uint opacity = forkLodFadeOpacity(surface);
  return opacity != 255u && forkLodFadeThreshold() >= opacity;
}

// Primary and indirect ray queries (resolve_expanded.slangh) drop RAY_FLAG_FORCE_OPAQUE while something fades, so a
// fading instance comes up as a candidate and a skipped surface is simply not committed: the traversal goes on behind
// it with nothing re-traced, and where a lod lies on its parent's facade the opaque parent wins the tie. Every other
// non-opaque candidate is committed as the flag would have.
uint forkLodFadeRayFlags(uint flags)
{
  return cb.lodFadeActive != 0u ? (flags & ~uint(RAY_FLAG_FORCE_OPAQUE)) : flags;
}

bool forkLodFadeCandidateSkipped(RayHitInfo candidate)
{
  return forkIsSurfaceFadedOut(surfaces[calculateSurfaceIndex(candidate)]);
}

// TraceRay path. The two sides of a cross fade share planes (a lod on its parent's facade), and the offset that pushes a
// ray past a skipped surface may push it past a surface right behind as well, so a skipped hit is handed to the nearest
// surface in the slab around it that the path keeps, with every triangle as a candidate. The slab is sized from that
// offset: the renderer's own measure of the float error at the hit, so a coplanar surface is inside it however close
// the camera, and it reaches as far along the ray as the offset moves the ray through surfaces parallel to the hit one.
// True when rayHitInfo now holds that candidate (its distance is from ray.origin like the hit it replaces).
bool forkLodFadeFindCoplanarHit(Ray ray, SurfaceInteraction surfaceInteraction, uint8_t rayMask, inout RayHitInfo rayHitInfo)
{
  const float offsetDistance = length(calculateRayOffset(surfaceInteraction.positionError, surfaceInteraction.geometryNormal));
  const float halfWidth = max(offsetDistance, rayHitInfo.hitDistance * 1e-4f);
  const float reach = offsetDistance / max(abs(dot(surfaceInteraction.geometryNormal, ray.direction)), 0.05f);

  RayDesc slab;
  slab.Origin = ray.origin + ray.direction * (rayHitInfo.hitDistance - halfWidth);
  slab.TMin = 0.0f;
  slab.Direction = ray.direction;
  slab.TMax = reach + 2.0f * halfWidth;

  const uint flags = RAY_FLAG_FORCE_NON_OPAQUE | RAY_FLAG_CULL_BACK_FACING_TRIANGLES;
  RayQuery<RAY_FLAG_FORCE_NON_OPAQUE | RAY_FLAG_CULL_BACK_FACING_TRIANGLES> rayQuery;
  rayQuery.TraceRayInline(topLevelAS, flags, uint(rayMask), slab);

  while (rayQuery.Proceed())
  {
    if (rayQuery.CandidateType() != CANDIDATE_NON_OPAQUE_TRIANGLE)
    {
      continue;
    }

    RayHitInfo candidate;
    RAY_HIT_INFO_CREATE_RAY_QUERY_CANDIDATE(candidate, rayQuery)

    if (candidate.customIndex == rayHitInfo.customIndex && candidate.geometryIndex == rayHitInfo.geometryIndex &&
        candidate.primitiveIndex == rayHitInfo.primitiveIndex)
    {
      continue;
    }

    if (forkIsSurfaceFadedOut(surfaces[calculateSurfaceIndex(candidate)]))
    {
      continue;
    }

    rayQuery.CommitNonOpaqueTriangleHit();
  }

  if (rayQuery.CommittedStatus() != COMMITTED_TRIANGLE_HIT)
  {
    return false;
  }

  RAY_HIT_INFO_CREATE_RAY_QUERY_COMMITTED(committed, rayQuery)
  committed.hitDistance += rayHitInfo.hitDistance - halfWidth;
  rayHitInfo = committed;
  return true;
}
