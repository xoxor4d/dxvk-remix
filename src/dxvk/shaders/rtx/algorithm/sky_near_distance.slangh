#pragma once

#include "rtx/utility/noise.slangh"
#include "rtx/concept/camera/camera.slangh"
#include "rtx/pass/sky_near_distance_args.h"
#include "rtx/pass/view_distance_args.h"

#include "rtx/external/simplex_noise.slangh"

// Inverse of evalViewDistance for reprojected 3D skybox geometry: rejects near hits and keeps far ones.
// Returns true if the sky hit should be kept, false if it should be skipped.
bool evalSkyNearDistance(SkyNearDistanceArgs skyNearDistanceArgs, bool isZUp, Camera camera, vec3 worldPosition)
{
  if (skyNearDistanceArgs.distanceMode == viewDistanceModeNone)
  {
    return true;
  }

  const vec3 cameraWorldPosition = cameraGetWorldPosition(camera);
  float viewDistance;

  if (skyNearDistanceArgs.distanceFunction == viewDistanceFunctionEuclidean)
  {
    viewDistance = length(cameraWorldPosition - worldPosition);
  }
  else
  {
    if (isZUp)
    {
      viewDistance = length(cameraWorldPosition.xy - worldPosition.xy);
    }
    else
    {
      viewDistance = length(cameraWorldPosition.xz - worldPosition.xz);
    }
  }

  if (skyNearDistanceArgs.distanceMode == viewDistanceModeHardCutoff)
  {
    return viewDistance >= skyNearDistanceArgs.distanceThresholdOrFadeMin;
  }
  else
  {
    const float t = saturate((viewDistance - skyNearDistanceArgs.distanceThresholdOrFadeMin) / skyNearDistanceArgs.distanceFadeSpan);

    if (t == 0.0f)
    {
      return false;
    }

    if (t == 1.0f)
    {
      return true;
    }

    const float coherentNoise = simplexNoise3D(worldPosition * skyNearDistanceArgs.noiseScale) * 0.5f + 0.5f;

    return coherentNoise < t;
  }
}

// Hard cutoff for shadow/visibility rays: keep only if at or beyond threshold / fade min.
bool evalSkyNearDistanceHardCutoff(SkyNearDistanceArgs skyNearDistanceArgs, bool isZUp, Camera camera, vec3 worldPosition)
{
  if (skyNearDistanceArgs.distanceMode == viewDistanceModeNone)
  {
    return true;
  }

  const vec3 cameraWorldPosition = cameraGetWorldPosition(camera);
  float viewDistance;

  if (skyNearDistanceArgs.distanceFunction == viewDistanceFunctionEuclidean)
  {
    viewDistance = length(cameraWorldPosition - worldPosition);
  }
  else
  {
    if (isZUp)
    {
      viewDistance = length(cameraWorldPosition.xy - worldPosition.xy);
    }
    else
    {
      viewDistance = length(cameraWorldPosition.xz - worldPosition.xz);
    }
  }

  float cutoff = skyNearDistanceArgs.distanceThresholdOrFadeMin;
  if (skyNearDistanceArgs.distanceMode == viewDistanceModeCoherentNoise)
  {
    cutoff += skyNearDistanceArgs.distanceFadeSpan;
  }

  return viewDistance >= cutoff;
}
