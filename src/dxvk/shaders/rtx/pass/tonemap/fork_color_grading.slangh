#pragma once

#include "rtx/utility/color.slangh"

// Post-tonemap color grading shared by the operator pass and the alt pass: tint, contrast around 18% grey,
// saturation around BT.709 luminance. `peak` is the pass's clamp ceiling, 1 in SDR.
float3 applyColorGrading(float3 color, float3 colorBalance, float contrast, float saturation, float peak)
{
  color = color * colorBalance;
  color = clamp((contrast * (color - 0.18f)) + 0.18f, 0.0f, max(peak, 1.0f));
  color = mix(float3(calcBt709Luminance(color)), color, saturation);

  return color;
}
