#pragma once

// ===========================================================================
// WARNING: NOTHING INCLUDES THIS FILE.
// ===========================================================================
// Verified 2026-09-22: `grep -rn '#include.*atmosphere_bindings' src/dxvk/shaders/`
// returns nothing. Every pass that samples the atmosphere gets its bindings
// from one of two other places instead:
//
//   - the ray-tracing passes (geometry_resolver, integrator_indirect, and so
//     everything that draws the sky to the eye) from common_bindings.slangh;
//   - the atmosphere's own compute passes (the LUT bakers, cloud_render) from
//     their own per-pass binding headers.
//
// So a binding added HERE is invisible: the declaration compiles, the resource
// is bound on the C++ side, and the shader that needs it still takes the
// #else branch of whatever availability #ifdef guards it. That is not
// hypothetical - it is exactly how the star catalogue shipped with every star
// missing, because the two StructuredBuffers were declared here and
// ATMOSPHERE_STAR_CATALOGUE_AVAILABLE was therefore never defined anywhere
// that mattered.
//
// If you are adding an atmosphere binding, add it to common_bindings.slangh
// (and to COMMON_RAYTRACING_BINDINGS in common_binding_indices.h). Leave this
// file alone, or delete it.
// ===========================================================================

#include "rtx/pass/common_binding_indices.h"

// Atmosphere LUT bindings - only include in shaders that need atmosphere rendering
layout(binding = BINDING_ATMOSPHERE_TRANSMITTANCE_LUT)
Texture2D AtmosphereTransmittanceLut;
// Signals to atmosphere_common.slangh that AtmosphereTransmittanceLut is bound.
// Mirrors the define in common_bindings.slangh; atmosphere-only compute passes
// (LUT bakers, cloud_render) do not include this file and therefore fall back
// to the analytical path inside getAtmosphericTransmittanceForDir.
#define ATMOSPHERE_TRANSMITTANCE_LUT_AVAILABLE

layout(binding = BINDING_ATMOSPHERE_MULTISCATTERING_LUT)
Texture2D AtmosphereMultiscatteringLut;

layout(binding = BINDING_ATMOSPHERE_SKY_VIEW_LUT)
Texture2D AtmosphereSkyViewLut;

// Linear sampler matched to the sky-view LUT parameterization:
// REPEAT-U for azimuth wrap at 0/2π, CLAMP-V for elevation so the bilinear
// at the pole rows doesn't mix horizon values across zenith/nadir.
layout(binding = BINDING_ATMOSPHERE_SKY_VIEW_SAMPLER)
SamplerState AtmosphereSkyViewSampler;

layout(binding = BINDING_ATMOSPHERE_CLOUD_NOISE_SAMPLER)
SamplerState AtmosphereCloudNoise3DSampler;
